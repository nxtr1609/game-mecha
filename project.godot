; Engine configuration file.
; Mở thư mục này bằng Godot 4.7 (Import > chọn file project.godot).

config_version=5

[application]

config/name="Game Mecha"
config/description="Game bắn mecha 3D: hai phe Trắng – Đen, mecha, chiến hạm trên trời, cứ điểm."
run/main_scene="res://scenes/menu_chinh.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

NgonNgu="*res://scripts/ngon_ngu.gd"
Phim="*res://scripts/phim.gd"
CanBang="*res://scripts/can_bang.gd"
TienTrinh="*res://scripts/tien_trinh.gd"
AmThanh="*res://scripts/am_thanh.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
